{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/entities/(.*)",
      "destination": "/api/entities/[...entity]"
    },
    {
      "source": "/apps/:appId/entities/(.*)",
      "destination": "/api/entities/[...entity]"
    },
    {
      "source": "/apps/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/api/whatsapp/status",
      "destination": "/api/whatsapp/status"
    },
    {
      "source": "/api/whatsapp/qr",
      "destination": "/api/whatsapp/qr"
    },
    {
      "source": "/api/functions/sendSaleBill",
      "destination": "/api/functions/sendSaleBill"
    },
    {
      "source": "/api/functions/sendWhatsAppInvoice",
      "destination": "/api/functions/sendWhatsAppInvoice"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api/|apps/).*)",
      "destination": "/index.html"
    }
  ]
}
