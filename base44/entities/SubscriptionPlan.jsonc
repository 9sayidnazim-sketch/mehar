{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Plan Name"
    },
    "price_label": {
      "type": "string",
      "title": "Price Label"
    },
    "amount": {
      "type": "number",
      "title": "Amount (AED)"
    },
    "duration_days": {
      "type": "number",
      "title": "Duration in Days"
    },
    "payment_url": {
      "type": "string",
      "title": "Payment Checkout URL"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 1
    },
    "provisional_access_hours": {
      "type": "number",
      "default": 48
    }
  },
  "required": [
    "name",
    "price_label",
    "duration_days",
    "payment_url"
  ]
}
