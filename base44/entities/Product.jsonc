{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "price": {
      "type": "number",
      "title": "Price",
      "default": 0
    },
    "category": {
      "type": "string",
      "title": "Category",
      "default": "General"
    },
    "stock": {
      "type": "number",
      "title": "Stock",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name",
    "price"
  ]
}