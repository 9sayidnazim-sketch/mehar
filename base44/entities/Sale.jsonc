{
  "name": "Sale",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "title": "Sale ID"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_phone": {
      "type": "string",
      "title": "Customer Phone"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "items": {
      "type": "array",
      "title": "Items",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal",
      "default": 0
    },
    "discount": {
      "type": "number",
      "title": "Discount",
      "default": 0
    },
    "tax_percent": {
      "type": "number",
      "title": "Tax %",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "title": "Tax Amount",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "title": "Amount Paid",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "title": "Balance Due",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method",
      "enum": [
        "Cash",
        "Card",
        "UPI",
        "Bank Transfer"
      ],
      "default": "Cash"
    },
    "payment_status": {
      "type": "string",
      "title": "Payment Status",
      "enum": [
        "Paid",
        "Partial",
        "Pending"
      ],
      "default": "Pending"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Completed",
        "Refunded",
        "Cancelled"
      ],
      "default": "Completed"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "bill_sent_whatsapp": {
      "type": "boolean",
      "title": "Bill Sent (WhatsApp)",
      "default": false
    },
    "bill_sent_email": {
      "type": "boolean",
      "title": "Bill Sent (Email)",
      "default": false
    },
    "source": {
      "type": "string",
      "title": "Source",
      "enum": [
        "manual",
        "online"
      ],
      "default": "manual"
    },
    "online_pending": {
      "type": "boolean",
      "title": "Pending Online Review",
      "default": false
    }
  },
  "required": [
    "sale_id",
    "date"
  ]
}